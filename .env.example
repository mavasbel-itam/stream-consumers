# Copy to .env (git-ignored) and fill in only the keys you have. Every key is optional:
# without it the source uses its keyless route.

# MBTA V3 API, raises 20 → 1,000 requests per minute. Sign-up: https://api-v3.mbta.com/register
MBTA_API_KEY=
# Transport for London Unified API. Sign-up: https://api-portal.tfl.gov.uk/signup
TFL_APP_KEY=
# NASA FIRMS MAP_KEY (not used by the 24 h files the consumer reads). Sign-up: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# Contact e-mail for Crossref's "polite" pool (optional, not a secret)
CROSSREF_MAILTO=
