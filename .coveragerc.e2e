# End-to-end tier: the CLI runs as a subprocess against local servers for every transport
# (tests/e2e). Gated scope: the composition root, the application services, the ports and every
# infrastructure adapter. Pure domain rules and decoders are gated by the unit tier; the source
# modules target real providers and are covered by the unit tier (captured messages) and the live tier.
# Output formats, the batching base and the database/broker outputs are gated by the unit and
# component tiers (the component tier writes into real servers); the e2e tier still runs every
# format and SQLite through the CLI (test_consume_into_every_text_format_and_sqlite) and every
# broker (test_consume_into_a_real_mqtt_broker, test_consume_into_kafka_nats_and_zeromq_...).
[run]
branch = true
parallel = true
data_file = .coverage.e2e
include =
    */stream_consumers/__main__.py
    */stream_consumers/adapters/inbound/*
    */stream_consumers/application/*
    */stream_consumers/ports/*
    */stream_consumers/adapters/outbound/providers/registry.py
    */stream_consumers/adapters/outbound/providers/http.py
    */stream_consumers/adapters/outbound/providers/auth.py
    */stream_consumers/adapters/outbound/providers/transports/*
    */stream_consumers/adapters/outbound/outputs/sinks.py
    */stream_consumers/adapters/outbound/system/*

[report]
# Three paths run only where coverage cannot record them, so the unit tier gates them
# (tests/unit/test_signals.py, tests/unit/test_cli.py::TestStop) and the e2e tier checks their effect
# by the exit status: a signal after the first one is either a repeat of the same stop, absorbed in
# a process that may already be past its last recorded step, or a second Ctrl+C or SIGTERM that ends
# the process by the signal's default action (test_one_stop_delivered_twice_at_once_still_ends_the_run_cleanly,
# test_a_second_signal_ends_a_run_stuck_in_writing_at_once); the quiet exception hook runs after
# coverage has stopped, as the interpreter ends on KeyboardInterrupt (test_ctrl_c_on_a_terminal_...);
# a Ctrl+C outside a run (`list`, `keys`, `verdict`) cannot be timed from outside the process.
exclude_also =
    if self\._signalled:
    def _quiet_keyboard_interrupt
    except KeyboardInterrupt:
fail_under = 100
show_missing = true
